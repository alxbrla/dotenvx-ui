{
  "name": "dotenvx-ui",
  "version": "0.1.2",
  "description": "Terminal and web UI for managing dotenvx environment files",
  "author": "Alexandru Burla <alexandru.burla@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alxbrla/dotenvx-ui.git"
  },
  "homepage": "https://github.com/alxbrla/dotenvx-ui",
  "bugs": "https://github.com/alxbrla/dotenvx-ui/issues",
  "type": "module",
  "bin": {
    "dotenvx-ui": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && vite build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --no-errors-on-unmatched",
    "test": "pnpm build && tsc --noEmit && node --import tsx/esm --test 'src/test/**/*.test.ts'",
    "coverage": "pnpm build && tsc --noEmit && c8 --reporter=text --reporter=lcov --include='src/**/*.ts' --exclude='src/test/**' --exclude='src/tui/**' --exclude='src/ui/app/**' --exclude='src/ui/server.ts' --exclude='src/cli.tsx' node --import tsx/esm --test 'src/test/**/*.test.ts'",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "dotenvx",
    "env",
    "tui",
    "cli",
    "dotenv"
  ],
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.71.2",
    "clipboardy": "^5.3.1",
    "express": "^5.2.1",
    "get-port": "^7.2.0",
    "ink": "^7.0.5",
    "lucide-react": "^1.21.0",
    "open": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
